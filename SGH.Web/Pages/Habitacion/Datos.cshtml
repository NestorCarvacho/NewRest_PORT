@page
@model SGH.Web.Pages.Habitacion.DatosModel
@{
    ViewData["Title"] = "Habitaciones";
}
<div id="habitaciones-app" class="panel-modulo">
    <header class="panel-modulo__cabecera">
        <h1>Habitaciones</h1>
        <button type="button" id="btnNuevaHabitacion" class="btn primario">Nueva habitación</button>
    </header>
    <div id="habitacionesAviso" class="aviso" hidden></div>
  <table id="tablaHabitaciones" class="tabla-modulo">
        <thead>
            <tr>
                <th>Acciones</th>
                <th>Código</th>
                <th>Sexo</th>
                <th>Pabellón</th>
                <th>Módulo</th>
                <th>Camas</th>
                <th>Hab./total</th>
                <th>Por turnos</th>
                <th>Exclusivo</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>
<div id="modalHabitacion" class="modal" hidden aria-hidden="true">
    <form id="formHabitacion" class="formulario-modulo">
        <h2 id="tituloFormHabitacion">Habitación</h2>
        <input type="hidden" id="hdnHabitacionId" value="0" />
        <input type="hidden" id="hdnOpcion" value="crear" />
        <label>Pabellón
            <select id="selPabellon" required></select>
        </label>
        <label>Módulo
            <select id="selModulo" required></select>
        </label>
        <label>Código / nombre
            <input id="txtNombre" required maxlength="100" />
        </label>
        <label>Sexo
            <select id="selSexo" required></select>
        </label>
        <label>N° camas (capacidad física)
            <input id="txtCantidadCamas" type="number" min="1" value="1" required />
        </label>
        <label>Estado
            <select id="selEstado"></select>
        </label>
        <label class="fila-check">
            <input id="chkReservable" type="checkbox" checked /> Reservable
        </label>
        <label class="fila-check">
            <input id="chkUsoPorTurnos" type="checkbox" /> Uso por turnos (MinutosMin/Max)
        </label>
        <label class="fila-check">
            <input id="chkUsoExclusivo" type="checkbox" /> Uso exclusivo (PersonasMax = todas las camas)
        </label>
        <label>Minutos higienización (mín.)
            <input id="txtMinutosMin" type="number" min="0" value="0" />
        </label>
        <div class="acciones-formulario">
            <button type="submit" class="btn primario">Guardar</button>
            <button type="button" id="btnCerrarModal" class="btn">Cancelar</button>
        </div>
    </form>
</div>
@section Scripts {
    <script type="module" src="~/Habitacion/Js/datosHabitacion.js" asp-append-version="true"></script>
}