<section class="modulo modulo-anclado" data-id="solicitud" hidden>
    <p class="modulo-estado" hidden></p>
    <div class="modulo-barra">
        <button type="button" class="boton-secundario" data-accion="actualizar" data-etiqueta="Actualizar">Actualizar</button>
        <partial name="Modulos/_ExportarDesplegable" />
        <button type="button" class="boton-secundario" data-accion="filtros">Filtros</button>
        <button type="button" class="boton-primario" data-accion="nueva-solicitud">Nueva solicitud</button>
    </div>
    <partial name="_TablaModulo" />
    <form class="formulario formulario-filtros-modulo" data-modulo="solicitud" hidden aria-hidden="true">
        <h3 class="formulario-titulo">Criterios</h3>
        <div class="formulario-grilla">
            <partial name="Modulos/_FiltrosPeriodo" />
            <label class="campo">
                <span>Grupo empresa</span>
                <select name="grupoId" class="selector-buscable" data-catalogo="grupos"></select>
            </label>
            <label class="campo">
                <span>Solicitante</span>
                <select name="solicitanteId" class="selector-buscable" data-catalogo="solicitantes"></select>
            </label>
            <label class="campo">
                <span>Estado</span>
                <select name="estado" class="selector-buscable" data-catalogo="estados"></select>
            </label>
            <label class="campo">
                <span>Número</span>
                <input type="number" name="numero" min="0" />
            </label>
        </div>
        <div class="formulario-pie">
            <button type="button" class="boton-secundario" data-accion="cerrar-panel">Cancelar</button>
            <button type="submit" class="boton-primario">Aplicar</button>
        </div>
    </form>
</section>