@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
    Layout = "_LayoutMinimo";
}

<section class="estado">
    <h1>Error en la aplicación</h1>
    <p>No se pudo completar la solicitud. Si el problema continúa, indique el identificador de seguimiento al soporte.</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Identificador:</strong> <code>@Model.RequestId</code></p>
    }
    <a class="boton-primario" asp-page="/Index">Volver al inicio</a>
    @if (Model.EsDesarrollo)
    {
        <p class="estado-ayuda-dev">En desarrollo puede haber detalle adicional en la consola del servidor o en la respuesta de depuración.</p>
    }
</section>