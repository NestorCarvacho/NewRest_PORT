@using System.Security.Claims
@using SGH.Web.Cuenta
@{
    var nombreEmpresa = User.FindFirstValue(ClaimsSesion.EmpresaMandanteNombre);
    nombreEmpresa = string.IsNullOrWhiteSpace(nombreEmpresa)
        ? "Gestión Hotelera"
        : nombreEmpresa.Length > 30 ? nombreEmpresa[..30] : nombreEmpresa;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestión Hotelera</title>
    <partial name="_Favicon" />
    <script src="~/js/core/tema.js" asp-append-version="true"></script>
    <partial name="_FontAwesome5" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.4/css/responsive.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/escritorio.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cookies.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
</head>
<body class="app-body">
    <header class="app-cromo">
        <div class="navbar-app">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button type="button" class="menu-hamburguesa" id="menu-hamburguesa" aria-expanded="false" aria-controls="menu-modulos-lateral" aria-label="Abrir menú de módulos">
                    <span class="menu-hamburguesa-linea" aria-hidden="true"></span>
                    <span class="menu-hamburguesa-linea" aria-hidden="true"></span>
                    <span class="menu-hamburguesa-linea" aria-hidden="true"></span>
                </button>
            }
            <a class="marca" asp-page="/Index">
                <img src="~/img/hosteat-logo-vertical.svg" alt="" />
                <span title="Gestión Hotelera - @nombreEmpresa">Gestión Hotelera - @nombreEmpresa</span>
            </a>
            <div class="buscador">
                <input id="buscar-modulo" type="search" placeholder="Buscar módulo" autocomplete="off" />
                <ul id="buscar-resultados" class="buscador-lista" hidden></ul>
            </div>
            <partial name="_SelectorIdioma" />
            <partial name="_SelectorTema" />
            <div class="usuario">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button type="button" class="usuario-boton" aria-expanded="false" aria-label="Cuenta">
                        <svg viewBox="0 0 24 24"><path d="M20 21a8 8 0 0 0-16 0" /><circle cx="12" cy="7" r="4" /></svg>
                        <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    <div class="usuario-menu" hidden>
                        <p>@User.Identity.Name</p>
                        <p class="version">versión @Configuracion["Aplicacion:Version"]</p>
                        <button type="button" data-preferencias-cookies>Preferencias de cookies</button>
                        <form method="post" asp-page="/Cuenta/Salir">
                            <button type="submit">Salir</button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="usuario-boton" asp-page="/Cuenta/Login">Ingresar</a>
                }
            </div>
        </div>
        @await Component.InvokeAsync("MenuPerfil")
    </header>

    <main class="contenido">
        <div class="solapas" id="solapas" hidden></div>
        <div id="vista-inicial" class="vista-inicial">
            @RenderBody()
        </div>
        <div id="paneles"></div>
    </main>

    <div id="velo" class="velo" hidden></div>
    <aside id="panel-lateral" class="panel-lateral" hidden aria-labelledby="panel-titulo">
        <div class="panel-cabeza">
            <h2 id="panel-titulo"></h2>
            <button type="button" id="panel-cerrar" class="panel-cerrar" aria-label="Cerrar">×</button>
        </div>
        <div id="panel-cuerpo" class="panel-cuerpo"></div>
    </aside>

    <form id="antifalsificacion" hidden method="post">
        @Html.AntiForgeryToken()
    </form>
    <partial name="_AvisoCookies" />
    <div id="avisos-escritorio" class="avisos-escritorio" aria-live="polite"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.4/js/dataTables.responsive.min.js"></script>
    <script src="~/js/core/idioma.js" asp-append-version="true"></script>
    <script src="~/js/aviso-cookies.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
