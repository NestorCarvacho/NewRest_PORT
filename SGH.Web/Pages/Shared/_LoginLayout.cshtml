@using SGH.Web.Cuenta
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestión Hotelera</title>
    <partial name="_Favicon" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cookies.css" asp-append-version="true" />
    <script>
        (function () {
            try {
                var crudo = sessionStorage.getItem("sgh.tarjeta");
                if (!crudo) return;
                var dato = JSON.parse(crudo);
                sessionStorage.removeItem("sgh.tarjeta");
                var actual = location.pathname.replace(/\/+$/, "").toLowerCase();
                var origen = String(dato.ruta || "").replace(/\/+$/, "").toLowerCase();
                var login = "/cuenta/login";
                var clave = "/cuenta/cambiarclave";
                var par = (origen.endsWith(login) && actual.endsWith(clave)) || (origen.endsWith(clave) && actual.endsWith(login));
                if (!par || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
                document.documentElement.classList.add("tarjeta-crece");
                document.documentElement.style.setProperty("--tarjeta-desde-ancho", dato.ancho + "px");
                document.documentElement.style.setProperty("--tarjeta-desde-alto", dato.alto + "px");
            } catch (error) { }
        })();
    </script>
</head>
<body class="login-body@(ViewData["Documento"] is true ? " login-documento" : "")">
    <svg xmlns="http://www.w3.org/2000/svg" hidden aria-hidden="true">
        <symbol id="i-eye" viewBox="0 0 24 24">
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
            <circle cx="12" cy="12" r="3" />
        </symbol>
        <symbol id="i-eye-off" viewBox="0 0 24 24">
            <path d="M3 3l18 18" />
            <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
            <path d="M9.9 5.2A10 10 0 0 1 12 5c6.5 0 10 7 10 7a18 18 0 0 1-3.2 4.2" />
            <path d="M6.1 6.1C3.6 7.9 2 12 2 12a18 18 0 0 0 5.2 5.5" />
        </symbol>
    </svg>
    <main class="login-page">
        <section class="login-card">
            <img class="login-logo" src="~/img/logo-sgh.png" alt="SGH" />
            <h1 class="login-title">@ViewData["PanelTitle"]</h1>
            @RenderBody()
            <img class="login-company" src="~/img/logo-compass.png" alt="Compass Group" />
            <p class="login-meta">versión @Configuracion["Aplicacion:Version"]</p>
            <nav class="login-legal" aria-label="Información legal">
                <a asp-page="/Privacy">Política de privacidad</a>
                <a asp-page="/Cookies">Cookies</a>
                <button type="button" data-preferencias-cookies>Preferencias</button>
            </nav>
        </section>
    </main>
    <partial name="_AvisoCookies" />
    <script>
        document.querySelectorAll("[data-toggle-password]").forEach(function (boton) {
            boton.addEventListener("click", function () {
                var campo = document.getElementById(boton.getAttribute("data-toggle-password"));
                if (!campo || campo.hasAttribute("data-clave-enmascarada")) return;
                var visible = campo.type === "password";
                campo.type = visible ? "text" : "password";
                boton.setAttribute("aria-pressed", visible ? "true" : "false");
                boton.setAttribute("aria-label", visible ? "Ocultar contraseña" : "Mostrar contraseña");
            });
        });

        document.querySelectorAll("[data-espera-segundos]").forEach(function (boton) {
            var segundos = parseInt(boton.getAttribute("data-espera-segundos"), 10);
            if (!segundos || segundos < 1) return;
            var etiqueta = boton.getAttribute("data-etiqueta") || "Entrar";
            var hasta = Date.now() + segundos * 1000;
            var formulario = boton.form;
            if (formulario) {
                formulario.addEventListener("submit", function (evento) {
                    if (boton.disabled) evento.preventDefault();
                });
            }

            function pintar() {
                var resta = Math.max(0, Math.ceil((hasta - Date.now()) / 1000));
                if (resta <= 0) {
                    window.clearInterval(reloj);
                    boton.disabled = false;
                    boton.textContent = etiqueta;
                    boton.removeAttribute("data-espera-segundos");
                    return;
                }
                var minutos = Math.floor(resta / 60);
                var sobra = resta % 60;
                boton.textContent = "Espere " + minutos + ":" + String(sobra).padStart(2, "0");
            }

            var reloj = window.setInterval(pintar, 1000);
            pintar();
        });
    </script>
    <script src="~/js/transicion-tarjeta.js" asp-append-version="true"></script>
    <script src="~/js/aviso-cookies.js" asp-append-version="true"></script>
    @{
        var pila = Context.Items[PilaAvisos.ClaveLista] as IReadOnlyList<PilaAvisos.AvisoGuardado> ?? PilaAvisos.Leer(Context.Request);
        var sale = Context.Items[PilaAvisos.ClaveSale] as string;
        var nuevos = Context.Items[PilaAvisos.ClaveNuevos] is int cantidad ? cantidad : 0;
        var exito = ViewData["AvisoExito"] as string;
        var ahoraAvisos = PilaAvisos.Ahora();
        if (pila.Count == 0 && !string.IsNullOrWhiteSpace(exito))
            pila = [new PilaAvisos.AvisoGuardado(exito, ahoraAvisos, ahoraAvisos + PilaAvisos.VidaMs)];
    }
    @if (pila.Count > 0 || !string.IsNullOrWhiteSpace(sale))
    {
        <ul class="avisos">
            @if (!string.IsNullOrWhiteSpace(sale))
            {
                <li class="aviso aviso-error aviso-sale" role="alert">
                    <span class="aviso-icono" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="m15 9-6 6" /><path d="M2.586 16.726A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2h6.624a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586z" /><path d="m9 9 6 6" /></svg>
                    </span>
                    <p class="aviso-texto">@sale</p>
                </li>
            }
            @for (var i = 0; i < pila.Count; i++)
            {
                var reciente = i >= pila.Count - nuevos;
                var esExito = pila[i].Texto == exito;
                var espera = PilaAvisos.EsperaMs(pila, i, ahoraAvisos);
                <li class="aviso @(esExito ? "aviso-exito" : "aviso-error")@(reciente ? " aviso-nuevo" : "")" role="@(esExito ? "status" : "alert")" data-espera="@espera">
                    <span class="aviso-icono" aria-hidden="true">
                        @if (esExito)
                        {
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24"><path d="m15 9-6 6" /><path d="M2.586 16.726A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2h6.624a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586z" /><path d="m9 9 6 6" /></svg>
                        }
                    </span>
                    <p class="aviso-texto">@pila[i].Texto</p>
                    <button type="button" class="aviso-cerrar" aria-label="Cerrar">
                        <svg viewBox="0 0 24 24"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
                    </button>
                </li>
            }
        </ul>
        <script src="~/js/avisos.js" asp-append-version="true"></script>
    }
</body>
</html>
