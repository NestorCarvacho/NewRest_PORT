@model SGH.Application.Navegacion.MenuEscritorioVm
@{
    var principales = Model.Grupos.Where(g => !g.EsConfiguracion).ToList();
    var configuracion = Model.Grupos.Where(g => g.EsConfiguracion).ToList();
}
<nav class="menu-app" aria-label="Módulos">
    @if (principales.Count > 0)
    {
        <div class="menu-grupo">
            @foreach (var grupo in principales)
            {
                <div class="menu-item">
                    <button type="button" class="menu-boton" aria-expanded="false">
                        @grupo.Titulo
                        <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    <div class="menu-desplegable">
                        <div class="menu-panel@(grupo.Titulo.Equals("Gestión", StringComparison.OrdinalIgnoreCase) ? " menu-panel-gestion" : "")">
                            @foreach (var columna in grupo.Columnas)
                            {
                                <div class="menu-columna">
                                    <h2>@columna.Titulo</h2>
                                    @foreach (var item in columna.Items)
                                    {
                                        if (item.Disponible && !string.IsNullOrEmpty(item.RutaPagina))
                                        {
                                            <a class="menu-enlace" asp-page="@item.RutaPagina" data-modulo="@item.ClaveModulo">@item.Nombre</a>
                                        }
                                        else
                                        {
                                            <button type="button" disabled title="@(item.TituloDeshabilitado ?? "No disponible")">@item.Nombre</button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    @if (configuracion.Count > 0)
    {
        <div class="menu-grupo">
            @foreach (var grupo in configuracion)
            {
                <div class="menu-item menu-config">
                    <button type="button" class="menu-boton" aria-expanded="false" aria-label="@grupo.Titulo">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.65 1.65 0 0 0 15 19.4a1.65 1.65 0 0 0-1 .6 1.65 1.65 0 0 1-2.84 0 1.65 1.65 0 0 0-1-.6 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-.6-1 1.65 1.65 0 0 1 0-2.84 1.65 1.65 0 0 0 .6-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-.6 1.65 1.65 0 0 1 2.84 0 1.65 1.65 0 0 0 1 .6 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c.14.31.22.65.22 1a1.65 1.65 0 0 0 .6 1 1.65 1.65 0 0 1 0 2.84 1.65 1.65 0 0 0-.82 1.16z" /></svg>
                        <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    <div class="menu-desplegable">
                        <div class="menu-panel">
                            @foreach (var columna in grupo.Columnas)
                            {
                                <div class="menu-columna">
                                    <h2>@columna.Titulo</h2>
                                    @foreach (var item in columna.Items)
                                    {
                                        if (item.Disponible && !string.IsNullOrEmpty(item.RutaPagina))
                                        {
                                            <a class="menu-enlace" asp-page="@item.RutaPagina" data-modulo="@item.ClaveModulo">@item.Nombre</a>
                                        }
                                        else
                                        {
                                            <button type="button" disabled title="@(item.TituloDeshabilitado ?? "No disponible")">@item.Nombre</button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</nav>