@{
    var moduloId = ViewData["ModuloId"] as string ?? "";
}
<partial name="_AvisosModuloPost" />
@if (string.IsNullOrEmpty(moduloId))
{
    <section class="bienvenida" id="modulo-inicial">
        <h1>Gestión Hotelera</h1>
        <p>Use el menú para abrir los módulos en solapas.</p>
    </section>
}
else
{
    <section class="bienvenida" id="modulo-inicial" data-modulo-inicial="@moduloId" hidden aria-hidden="true"></section>
}