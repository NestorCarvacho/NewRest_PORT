@* Solapas del Index: mismo markup que cada /Modulo/Datos.cshtml (partial _Listado en la carpeta del módulo). *@
<div id="plantillas-modulos" hidden aria-hidden="true">
    <template id="plantilla-modulo-habitaciones">
        @{
            ViewData["ModuloId"] = "habitaciones";
        }
        <partial name="~/Pages/Habitacion/_Listado.cshtml" />
    </template>
    <template id="plantilla-modulo-banos">
        @{
            ViewData["ModuloId"] = "banos";
        }
        <partial name="~/Pages/Habitacion/_ListadoBanos.cshtml" />
    </template>
    <template id="plantilla-modulo-tiposcama">
        <partial name="~/Pages/Habitacion/_ListadoTiposCama.cshtml" />
    </template>
    <template id="plantilla-modulo-reserva">
        @{
            ViewData["ModuloId"] = "reserva";
        }
        <partial name="~/Pages/Reserva/_Listado.cshtml" />
    </template>
    <template id="plantilla-modulo-censo">
        @{
            ViewData["ModuloId"] = "censo";
        }
        <partial name="~/Pages/Censo/_Listado.cshtml" />
    </template>
    <template id="plantilla-modulo-misCensos">
        <partial name="~/Pages/Censo/_ListadoMisCensos.cshtml" />
    </template>
    <template id="plantilla-modulo-solicitud">
        @{
            ViewData["ModuloId"] = "solicitud";
        }
        <partial name="~/Pages/Solicitud/_Listado.cshtml" />
    </template>
</div>