@{
    ViewData["ModuloId"] = "habitaciones";
}
<section class="modulo modulo-anclado" data-id="habitaciones" hidden>
    <p class="modulo-estado" hidden></p>
    <div class="modulo-barra">
        <button type="button" class="boton-secundario" data-accion="actualizar" data-etiqueta="Actualizar">Actualizar</button>
        <partial name="Modulos/_ExportarDesplegable" />
        <button type="button" class="boton-secundario" data-accion="filtros">Filtros</button>
        <button type="button" class="boton-primario" data-accion="nueva-habitacion">Nueva habitación</button>
    </div>
    <partial name="_TablaModulo" />
    <form class="formulario formulario-filtros-modulo" data-modulo="habitaciones" hidden aria-hidden="true">
        <h3 class="formulario-titulo">Criterios</h3>
        <div class="formulario-grilla">
            <label class="campo">
                <span>Pabellón</span>
                <select name="pabellonId" class="selector-buscable" data-catalogo="pabellones"></select>
            </label>
            <label class="campo">
                <span>Módulo</span>
                <select name="moduloId" class="selector-buscable" data-catalogo="modulos"></select>
            </label>
            <label class="campo">
                <span>Estado</span>
                <select name="estado" class="selector-buscable" data-catalogo="estadosHabitacion"></select>
            </label>
            <label class="campo">
                <span>Solo activas</span>
                <select name="soloActivas" class="selector-buscable">
                    <option value="1">Sí</option>
                    <option value="0" selected>No (todas)</option>
                </select>
            </label>
        </div>
        <div class="formulario-pie">
            <button type="button" class="boton-secundario" data-accion="cerrar-panel">Cancelar</button>
            <button type="submit" class="boton-primario">Aplicar</button>
        </div>
    </form>
</section>