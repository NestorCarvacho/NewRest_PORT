@* Solapas del Index: mismo markup que Pages/Censo/Datos.cshtml (sección del módulo). *@
<section class="modulo modulo-anclado" data-id="censo" hidden>
    <p class="modulo-estado" hidden></p>
    <div class="modulo-barra">
        <button type="button" class="boton-secundario" data-accion="actualizar" data-etiqueta="Actualizar">Actualizar</button>
        <partial name="Modulos/_ExportarDesplegable" />
        <button type="button" class="boton-secundario" data-accion="filtros">Filtros</button>
        <button type="button" class="boton-secundario" data-accion="censo-qr">Censo QR</button>
        <button type="button" class="boton-primario" data-accion="guardar-censo" hidden data-rol="guardar-censo">Guardar</button>
    </div>
    <partial name="_TablaModulo" />
    <form class="formulario formulario-filtros-modulo" data-modulo="censo" hidden aria-hidden="true">
        <h3 class="formulario-titulo">Criterios</h3>
        <div class="formulario-grilla">
            @{
                ViewData["FiltroEtiquetaPeriodo"] = "Período (fecha censo)";
            }
            <partial name="Modulos/_FiltrosPeriodo" />
            <label class="campo">
                <span>Módulo</span>
                <select name="modulo" class="selector-buscable" data-catalogo="modulos"></select>
            </label>
            <label class="campo">
                <span>Piso</span>
                <select name="piso" class="selector-buscable" data-catalogo="pisos"></select>
            </label>
            <label class="campo">
                <span>Habitación</span>
                <select name="habitacion" class="selector-buscable" data-catalogo="habitaciones"></select>
            </label>
            <label class="campo">
                <span>Turno</span>
                <select name="turno" class="selector-buscable">
                    <option value="D" selected>Día</option>
                    <option value="N">Noche</option>
                </select>
            </label>
        </div>
        <div class="formulario-pie">
            <button type="button" class="boton-secundario" data-accion="cerrar-panel">Cancelar</button>
            <button type="submit" class="boton-primario">Aplicar</button>
        </div>
    </form>
</section>